<Window x:Class="AutoCutStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCut Studio — Phase 1"
        Width="1366"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="AutoCut Studio" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Pixel Agent Virtual Video Studio — Phase 1 Core Working Product"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="ProjectHeaderText" Text="ยังไม่ได้เปิด Project" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ToolHeaderText" Text="กำลังตรวจ FFmpeg..." HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="Pixel Office">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="วันนี้ต้องการสร้างวิดีโอแบบไหน?" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Phase 1 รองรับการนำเข้า MP4 → กำหนด Timeline → Export จริงเท่านั้น ฟังก์ชัน AI ยังไม่รองรับ"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,8"/>
                                <DockPanel>
                                    <TextBox x:Name="CommandTextBox"
                                             Text="ตัดวิดีโอตามช่วงที่เลือก"
                                             IsReadOnly="True"
                                             DockPanel.Dock="Left"
                                             MinWidth="520"/>
                                    <Button Content="เปิด Editor" Click="OpenEditor_Click"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="5">
                            <Border x:Name="ProducerCard" Background="{StaticResource PanelBrush}" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="5">
                                <StackPanel>
                                    <Border x:Name="ProducerAvatar" Width="54" Height="54" Background="#64748B"
                                            CornerRadius="4" HorizontalAlignment="Center">
                                        <TextBlock Text="P" FontSize="30" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="โปรดิวเซอร์" FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Producer Room" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ProducerStatus" Text="idle" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <ProgressBar x:Name="ProducerProgress" Height="8" Minimum="0" Maximum="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="ProducerMessage" Text="ไม่มีงาน" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="MediaAnalystCard" Background="{StaticResource PanelBrush}" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="5">
                                <StackPanel>
                                    <Border x:Name="MediaAnalystAvatar" Width="54" Height="54" Background="#64748B"
                                            CornerRadius="4" HorizontalAlignment="Center">
                                        <TextBlock Text="M" FontSize="30" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="นักวิเคราะห์สื่อ" FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Media Library" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MediaAnalystStatus" Text="idle" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <ProgressBar x:Name="MediaAnalystProgress" Height="8" Minimum="0" Maximum="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="MediaAnalystMessage" Text="ไม่มีงาน" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="VideoEditorCard" Background="{StaticResource PanelBrush}" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="5">
                                <StackPanel>
                                    <Border x:Name="VideoEditorAvatar" Width="54" Height="54" Background="#64748B"
                                            CornerRadius="4" HorizontalAlignment="Center">
                                        <TextBlock Text="V" FontSize="30" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ช่างตัดต่อ" FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Editing Studio" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="VideoEditorStatus" Text="idle" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <ProgressBar x:Name="VideoEditorProgress" Height="8" Minimum="0" Maximum="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="VideoEditorMessage" Text="ไม่มีงาน" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="QualityControlCard" Background="{StaticResource PanelBrush}" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="5">
                                <StackPanel>
                                    <Border x:Name="QualityControlAvatar" Width="54" Height="54" Background="#64748B"
                                            CornerRadius="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Q" FontSize="30" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ตรวจคุณภาพ" FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Quality Control" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="QualityControlStatus" Text="idle" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <ProgressBar x:Name="QualityControlProgress" Height="8" Minimum="0" Maximum="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="QualityControlMessage" Text="ไม่มีงาน" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="RenderCard" Background="{StaticResource PanelBrush}" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="5">
                                <StackPanel>
                                    <Border x:Name="RenderAvatar" Width="54" Height="54" Background="#64748B"
                                            CornerRadius="4" HorizontalAlignment="Center">
                                        <TextBlock Text="R" FontSize="30" FontWeight="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="เรนเดอร์" FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Render Farm" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="RenderStatus" Text="idle" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <ProgressBar x:Name="RenderProgress" Height="8" Minimum="0" Maximum="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="RenderMessage" Text="ไม่มีงาน" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="5,12,5,5">
                            <StackPanel>
                                <TextBlock Text="Agent Event Log (เหตุการณ์จริง)" FontWeight="Bold"/>
                                <TextBox x:Name="AgentEventLogTextBox" Height="210" IsReadOnly="True"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Editor">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="Black" CornerRadius="6" Margin="0,0,10,10">
                        <MediaElement x:Name="PreviewPlayer"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      MediaOpened="PreviewPlayer_MediaOpened"
                                      MediaFailed="PreviewPlayer_MediaFailed"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Source Metadata" FontSize="17" FontWeight="Bold"/>
                            <TextBox x:Name="EditorMetadataTextBox" IsReadOnly="True" AcceptsReturn="True"
                                     Height="235" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock x:Name="SelectionSummaryText" Text="In: 0.000 | Out: 0.000"
                                       FontFamily="Consolas" Margin="4"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <Slider x:Name="TimelineSlider" Minimum="0" Maximum="1" ValueChanged="TimelineSlider_ValueChanged"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="▶ Play" Click="Play_Click"/>
                                <Button Content="⏸ Pause" Click="PausePreview_Click"/>
                                <Button Content="ตั้ง In" Click="SetIn_Click"/>
                                <Button Content="ตั้ง Out" Click="SetOut_Click"/>
                                <Button Content="ใช้ช่วง In/Out" Click="ApplyRange_Click"/>
                                <Button Content="Split ที่ Playhead" Click="Split_Click"/>
                                <Button Content="Delete Segment" Click="DeleteSegment_Click"/>
                                <Button Content="Undo" Click="Undo_Click"/>
                                <Button Content="Redo" Click="Redo_Click"/>
                                <Button Content="สร้าง Export Job" Click="CreateExportJob_Click" Background="#0E7490"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10">
                        <DataGrid x:Name="TimelineGrid" AutoGenerateColumns="False" SelectionMode="Single"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Segment" Binding="{Binding Id}" Width="2*"/>
                                <DataGridTextColumn Header="Start (s)" Binding="{Binding StartSeconds, StringFormat=0.000}" Width="*"/>
                                <DataGridTextColumn Header="End (s)" Binding="{Binding EndSeconds, StringFormat=0.000}" Width="*"/>
                                <DataGridTextColumn Header="Duration (s)" Binding="{Binding DurationSeconds, StringFormat=0.000}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Job Center">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="JobsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="JobsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding Id}" Width="1.3*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="*"/>
                            <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" Width="1.2*"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                            <DataGridTextColumn Header="Output" Binding="{Binding Output}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="1" Margin="0,8">
                        <Button Content="Pause" Click="PauseJob_Click"/>
                        <Button Content="Resume" Click="ResumeJob_Click"/>
                        <Button Content="Cancel" Click="CancelJob_Click"/>
                        <Button Content="Retry เป็น Version ใหม่" Click="RetryJob_Click"/>
                        <Button Content="เปิด Output" Click="OpenOutput_Click"/>
                        <Button Content="เปิด Job Folder" Click="OpenJobFolder_Click"/>
                    </WrapPanel>

                    <TextBox x:Name="JobLogTextBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </Grid>
            </TabItem>

            <TabItem Header="Project / Media">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Project Manager" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="ชื่อ Project"/>
                            <TextBox x:Name="ProjectNameTextBox" Text="My AutoCut Project"/>
                            <Button Content="สร้าง Project" Click="CreateProject_Click"/>
                            <Button Content="เปิด project.json" Click="OpenProject_Click"/>
                            <Button Content="Import MP4" Click="ImportMp4_Click" Background="#0E7490"/>
                            <Button Content="เปิด Project Folder" Click="OpenProjectFolder_Click"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="Dependency Status" FontWeight="Bold"/>
                            <TextBlock x:Name="ToolStatusText" TextWrapping="Wrap" Margin="4"/>
                            <TextBlock Text="ไม่มีการ Upload ขึ้น Cloud ใน Phase 1"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="4,12,4,4"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Media Library / FFprobe" FontSize="18" FontWeight="Bold"/>
                            <TextBox x:Name="ProjectPathTextBox" IsReadOnly="True" Height="42"/>
                            <TextBox x:Name="MediaMetadataTextBox" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" Height="480"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusBarText" Text="พร้อม — ยังไม่ได้เปิด Project"/>
                <TextBlock DockPanel.Dock="Right" Text="Local-first | Source read-only | No overwrite | asInvoker"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
