<Window x:Class="AutoCutStudio.App.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech Editing — Whisper Local Transcript"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="ถอดเสียงและแก้ Transcript" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="ประมวลผลด้วย Whisper ภายในเครื่อง ไม่อัปโหลดวิดีโอ และสร้าง Subtitle SRT จริง"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <TextBlock x:Name="SpeechToolStatusText" DockPanel.Dock="Right" Text="กำลังตรวจ Whisper..."
                       HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="ภาษา" FontWeight="SemiBold"/>
                <ComboBox x:Name="LanguageComboBox" SelectedIndex="0" Margin="4" Padding="7">
                    <ComboBoxItem Content="ตรวจภาษาอัตโนมัติ" Tag="auto"/>
                    <ComboBoxItem Content="ภาษาไทย" Tag="th"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="การประมวลผล" FontWeight="SemiBold"/>
                <CheckBox x:Name="UseGpuCheckBox" Content="ใช้ GPU หากรองรับ" IsChecked="True" Margin="8,10,4,4"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="ค้นหา Transcript" FontWeight="SemiBold"/>
                <TextBox x:Name="SearchTextBox" KeyDown="SearchTextBox_KeyDown"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="ค้นหา" Click="Search_Click"/>
                <Button Content="แสดงทั้งหมด" Click="ShowAll_Click"/>
                <Button x:Name="TranscribeButton" Content="ถอดเสียงใหม่" Click="Transcribe_Click" Background="#0E7490"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <ProgressBar x:Name="SpeechProgressBar" Height="10" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="SpeechStatusText" Text="ยังไม่มี Transcript" Margin="4,7,4,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="TranscriptGrid" Grid.Row="3" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionMode="Single" CellEditEnding="TranscriptGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="55" IsReadOnly="True"/>
                <DataGridTextColumn Header="เริ่ม (s)" Binding="{Binding StartSeconds, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="จบ (s)" Binding="{Binding EndSeconds, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="ข้อความ — แก้ไขได้" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridCheckBoxColumn Header="ตัดออก" Binding="{Binding IsExcluded, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                <DataGridCheckBoxColumn Header="Filler" Binding="{Binding IsFiller, UpdateSourceTrigger=PropertyChanged}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="Confidence" Binding="{Binding AverageProbability, StringFormat=P0}" Width="95" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Transcript / Subtitle Summary" Margin="0,0,8,0">
                <TextBox x:Name="TranscriptSummaryTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Technical Log">
                <TextBox x:Name="TechnicalLogTextBox" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="▶ เล่นช่วงที่เลือก" Click="PlaySelected_Click"/>
                <Button Content="ตรวจ Filler เดี่ยว" Click="MarkFillers_Click"/>
                <Button Content="บันทึก Transcript" Click="Save_Click"/>
                <Button Content="Export SRT" Click="ExportSrt_Click"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ปิด" Click="Close_Click"/>
                <Button x:Name="ApplyTimelineButton" Content="ใช้รายการ ‘ตัดออก’ กับ Timeline"
                        Click="ApplyTimeline_Click" IsEnabled="False" Background="#047857"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
