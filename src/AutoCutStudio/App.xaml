<Application x:Class="AutoCutStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#10131A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#181D27" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9EA7B8" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#2A3140" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
