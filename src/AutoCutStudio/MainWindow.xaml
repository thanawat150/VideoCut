<Window x:Class="AutoCutStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCut Studio" Width="1280" Height="800" MinWidth="1000" MinHeight="650"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="220" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button Content="โปรเจกต์ใหม่" Click="NewProject_Click" />
        <Button Content="เปิดโปรเจกต์" Click="OpenProject_Click" />
        <Button Content="นำเข้าวิดีโอ" Click="ImportMedia_Click" />
        <Button Content="บันทึก" Click="SaveProject_Click" />
      </StackPanel>
      <TextBlock x:Name="ProjectTitle" Text="ยังไม่ได้เปิดโปรเจกต์" FontSize="18" FontWeight="SemiBold"
                 VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="MEDIA" FontWeight="Bold" Margin="4,0,0,10" />
          <ListBox x:Name="MediaList" SelectionChanged="MediaList_SelectionChanged"
                   Background="Transparent" BorderThickness="0" Foreground="White" />
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#080A0F" CornerRadius="10" Padding="8">
        <Grid>
          <MediaElement x:Name="PreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                        MediaOpened="PreviewPlayer_MediaOpened" />
          <Border VerticalAlignment="Bottom" Background="#AA10131A" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="▶ เล่น" Click="Play_Click" />
              <Button Content="⏸ หยุดชั่วคราว" Click="Pause_Click" />
              <Button Content="■ หยุด" Click="Stop_Click" />
              <TextBlock x:Name="PositionText" Text="00:00:00 / 00:00:00" VerticalAlignment="Center" Margin="12,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="10,0,0,0">
        <StackPanel>
          <TextBlock Text="ASSISTANT / INSPECTOR" FontWeight="Bold" Margin="4,0,0,10" />
          <TextBlock Text="วันนี้ต้องการสร้างวิดีโอแบบไหน?" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
          <TextBox x:Name="AssistantInput" Height="90" Margin="4,10" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"
                   Background="#242B38" Foreground="White" BorderThickness="0"
                   Text="Phase 1 รองรับ Import, Preview, Split, Trim, Delete และ Export MP4 จริง" />
          <Separator Margin="4,12" />
          <TextBlock Text="เครื่องมือคลิป" FontWeight="SemiBold" />
          <Button Content="แยกคลิปที่ตำแหน่งปัจจุบัน" Click="Split_Click" />
          <Button Content="ตั้งจุดเริ่มจากตำแหน่งปัจจุบัน" Click="SetIn_Click" />
          <Button Content="ตั้งจุดจบจากตำแหน่งปัจจุบัน" Click="SetOut_Click" />
          <Button Content="ลบคลิปที่เลือก" Click="DeleteClip_Click" />
          <Button Content="Export คลิปที่เลือกเป็น MP4" Background="{StaticResource AccentBrush}" Click="Export_Click" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Margin="0,10,0,0" Padding="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="TIMELINE — VIDEO 1" FontWeight="Bold" Margin="4,0,0,8" />
        <ListBox x:Name="TimelineList" Background="Transparent" BorderThickness="0" Foreground="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#39445A" CornerRadius="6" Padding="12" Margin="4" MinWidth="180">
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SourceIn}" FontSize="11" Foreground="#C5CBD7" />
                  <TextBlock Text="{Binding SourceOut}" FontSize="11" Foreground="#C5CBD7" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <ProgressBar x:Name="JobProgress" Width="260" Height="10" Minimum="0" Maximum="100" DockPanel.Dock="Right" />
      <TextBlock x:Name="StatusText" Text="พร้อมใช้งาน — กรุณาสร้างหรือเปิดโปรเจกต์" Foreground="{StaticResource MutedTextBrush}" />
    </DockPanel>
  </Grid>
</Window>
